<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>drinks_robot</name>
  <version>0.0.0</version>
  <description>Dual-arm drink service robot node with container ArUco and cup detection pipeline.</description>
  <maintainer email="94117313+TienYuWu@users.noreply.github.com">ncku_csie_rl</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>dual_amm</depend>
  <depend>drinks_robot_interface</depend>
  <depend>ament_index_python</depend>
  <depend>py_trees</depend>
  <depend>py_trees_ros</depend>
  <depend>rqt_gui</depend>
  <depend>rqt_gui_py</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
